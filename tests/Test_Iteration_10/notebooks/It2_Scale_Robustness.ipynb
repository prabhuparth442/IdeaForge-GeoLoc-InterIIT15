{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "d0018da0",
   "metadata": {},
   "source": [
    "# T10 It2: inlier-scale robustness of the judge\n",
    "\n",
    "T9 showed the judge answers wrong places when every candidate's inlier signals rise together (x1.25 -> 2-3 wrong on NUDT 707), mostly\n",
    "through the 12-inlier override. Variants (block `train/checks/scale_robust.py`), each trained on NUDT design sets only, cut by Learn-then-Test\n",
    "(alpha 0.005, floor 0.9) on the training sets (for augmented variants: on every scaled copy, so the cut must hold across the range):\n",
    "\n",
    "- V0 current judge + 12-inlier override (the T8 recommendation)\n",
    "- V1 no override\n",
    "- V2 relative inliers: rli = log((inliers + 1) / (running far-candidate inliers + 1)), likewise n22; the far (> 4 sigma) candidates are\n",
    "  almost all wrong places, so their level measures this camera / map / matcher without labels (running mean per run, dev prior, weight 30)\n",
    "- V3 scale augmentation: train on copies of every set with inlier signals x0.5, 0.75, 1, 1.5, 2\n",
    "- V4 no override + safety switch: photos whose running far-inlier level is outside the dev range (+-25 %) use the strict mode (cut 0.98)\n",
    "- V5 relative + augmentation\n",
    "\n",
    "**Test:** leave one NUDT design set out (train on the other four) and official TRY (train on all five), with every inlier-count signal of\n",
    "the held-out set scaled x0.5, 0.75, 1, 1.25, 1.5, 2. PC (M = 10) and Jetson (M = 5, context from the 5 matched candidates). **A variant\n",
    "counts only with 0 wrong answers at every scale on every held-out set**; the score kept is reported against x1."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "10e293b2",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, sys, time\n",
    "os.environ[\"OMP_NUM_THREADS\"] = \"1\"                    # 12 processes below, one thread each\n",
    "from pathlib import Path\n",
    "ROOT = Path.cwd()\n",
    "while not (ROOT / \"single_photo_pipeline.py\").exists():\n",
    "    ROOT = ROOT.parent\n",
    "sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(ROOT / \"src\")); os.chdir(ROOT)\n",
    "import numpy as np, pandas as pd\n",
    "pd.set_option(\"display.width\", 250); pd.set_option(\"display.max_columns\", 40)\n",
    "import train.checks.candidate_judge as cj\n",
    "import train.checks.scale_robust as sr\n",
    "from train.checks.holdout import NUDT_DESIGN, load_t8_table\n",
    "from train.checks.eval_tools import manifest, save_manifest\n",
    "RES = ROOT / \"tests/Test_Iteration_10/results\"\n",
    "T = load_t8_table(ROOT, locked=True)            # NUDT design + official TRY only\n",
    "SCALES = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0]\n",
    "AUG = [0.5, 0.75, 1.0, 1.5, 2.0]\n",
    "F = cj.FEATURES_CTX; INC = {\"li\", \"z\", \"hull\", \"cover9\"}\n",
    "FR = [(\"rli\" if f == \"li\" else \"rln22\" if f == \"ln22\" else f) for f in F]; INCR = {\"rli\", \"z\", \"hull\", \"cover9\"}\n",
    "VARIANTS = {   # name: (features, increasing, augment, relative, override, safety)\n",
    "    \"V0 current + override 12\": (F, INC, None, False, 12, False),\n",
    "    \"V1 no override\": (F, INC, None, False, None, False),\n",
    "    \"V2 relative inliers\": (FR, INCR, None, True, None, False),\n",
    "    \"V3 scale augmentation\": (F, INC, AUG, False, None, False),\n",
    "    \"V4 no override + safety switch\": (F, INC, None, False, None, True),\n",
    "    \"V5 relative + augmentation\": (FR, INCR, AUG, True, None, False)}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "183f4a93",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run(var_name, ctx_m, held_sets, train_sets):\n",
    "    feats, inc, aug, rel, override, safety = VARIANTS[var_name]\n",
    "    train = T[T.data.isin(train_sets)]\n",
    "    if ctx_m: train = cj.add_context(train, m=ctx_m)\n",
    "    lv = sr.far_levels(train, ctx_m); prior = dict(far_inl=lv.far_inl.mean(), far_n22=lv.far_n22.mean())\n",
    "    tr = (lambda t: sr.add_relative(t, prior, 30, ctx_m)) if rel else None\n",
    "    model, p_oof, stacked = sr.fit_judge(train, train_sets, feats, inc, aug, tr)\n",
    "    kw = dict(min_choice=3, wide_tau=0.95, override=override)\n",
    "    if ctx_m: kw.update(jetson=True, m=ctx_m)\n",
    "    names = stacked.data + \"_x\" + stacked.scale_factor.astype(str)\n",
    "    tau = cj.ltt_tau(cj.scan_tau(stacked.assign(data=names), p_oof, cj.TAUS, **kw), list(names.unique()), 0.005)\n",
    "    tau = cj.NO_ANSWER if tau is None else max(tau, 0.9)\n",
    "    fin = sr.running_level(lv, prior).groupby(\"data\").run_inl.last()\n",
    "    low, high = fin.min() * 0.75, fin.max() * 1.25\n",
    "    rows = []\n",
    "    for f in SCALES:\n",
    "        h = sr.add_relative(sr.scale_signals(T[T.data.isin(held_sets)], f, m=ctx_m), prior, 30, ctx_m)\n",
    "        p = sr.predict(model, h, feats)\n",
    "        strict_share = 0.0\n",
    "        if safety:\n",
    "            strict = sr.safety_mode(h, low, high); p = np.where(strict & (p < 0.98), 0.0, p)\n",
    "            strict_share = float(h.assign(s=strict).groupby([\"data\", \"photo\"]).s.first().mean())\n",
    "        s = cj.summary(cj.decide(h, p, tau, **kw))\n",
    "        for d in s.index:\n",
    "            rows.append(dict(variant=var_name, var=\"jetson\" if ctx_m else \"pc\", held=d, scale=f, tau=tau, score=s.loc[d, \"score\"], wrong=int(s.loc[d, \"wrong\"]),\n",
    "                             answered=s.loc[d, \"answered\"], queries=s.loc[d, \"queries\"], strict_share=strict_share))\n",
    "    return rows\n",
    "\n",
    "from joblib import Parallel, delayed\n",
    "jobs = [(v, m, [h], [s for s in NUDT_DESIGN if s != h]) for v in VARIANTS for m in (None, 5) for h in NUDT_DESIGN]\n",
    "jobs += [(v, m, [\"official_try\"], NUDT_DESIGN) for v in VARIANTS for m in (None, 5)]\n",
    "t0 = time.time()\n",
    "SWEEP = pd.DataFrame([r for rr in Parallel(n_jobs=int(os.environ.get("JOBS", "4")))(delayed(run)(*j) for j in jobs) for r in rr])\n",
    "SWEEP.to_csv(RES / \"it2_scale_sweep.csv\", index=False)\n",
    "save_manifest(RES / \"it2_scale_sweep.csv\", manifest(\"pc\", cut=\"Learn-then-Test alpha 0.005 per variant, floor 0.9\", wide_cut=0.95, override=\"V0: 12, others none\",\n",
    "              judge_features=\"FEATURES_CTX or relative (rli, rln22)\", judge_trained_on=\"NUDT design sets, leave one out\", note=\"M = 10 (pc) and M = 5 (jetson) rows\"))\n",
    "print(\"%d runs, %.0f s\" % (len(jobs), time.time() - t0))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a622576f",
   "metadata": {},
   "source": [
    "## Wrong answers summed over the held-out sets, per scale"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4655ecf7",
   "metadata": {},
   "outputs": [],
   "source": [
    "SWEEP.pivot_table(index=[\"var\", \"variant\"], columns=\"scale\", values=\"wrong\", aggfunc=\"sum\").astype(int)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "84d0786c",
   "metadata": {},
   "source": [
    "## Score (mean over the held-out NUDT sets, and official TRY) per scale"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6ba05768",
   "metadata": {},
   "outputs": [],
   "source": [
    "S2 = SWEEP.assign(group=np.where(SWEEP.held == \"official_try\", \"official_try\", \"NUDT (mean of 5)\"))\n",
    "S2.pivot_table(index=[\"var\", \"variant\", \"group\"], columns=\"scale\", values=\"score\", aggfunc=\"mean\").round(2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f6e852e4",
   "metadata": {},
   "outputs": [],
   "source": [
    "x1 = S2[S2.scale == 1.0].groupby([\"var\", \"variant\", \"group\"]).score.mean()\n",
    "ok = SWEEP.groupby([\"var\", \"variant\"]).wrong.sum().eq(0).rename(\"0 wrong at every scale\")\n",
    "kept = S2.groupby([\"var\", \"variant\", \"group\"]).score.mean().rename(\"mean over scales\")\n",
    "pd.concat([x1.rename(\"score at x1\"), kept], axis=1).join(ok, on=[\"var\", \"variant\"]).round(2)"
   ]
  }
 ],
