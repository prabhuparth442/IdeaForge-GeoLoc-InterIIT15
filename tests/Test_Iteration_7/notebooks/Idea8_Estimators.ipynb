    "import torch, gc, cv2\n",
    "from train.checks.rich_dump import RichDumpPipeline\n",
    "from train.checks.perturb import perturbed_item\n",
    "from image_processing.thermal import load_thermal_frame\n",
    "from image_processing.geometry import render_query\n",
    "from image_processing.map_levels import map_piece, level_for_height\n",
    "from coarse_search.heading_queries import query_geometry\n",
    "pipeline = RichDumpPipeline(DATA, \"edge_zncc\", semantic_layer=True, semantic_decision=True, gamma=GAMMA, k_peaks=K_PER_QUERY, m_fine=M_PER_QUERY,\n",
    "                            matcher=\"loftr_minima\", min_inliers=MIN_INLIERS, ransac_pixels=None, matcher_confidence=MATCHER_CONFIDENCE, satellite=MAP,\n",
    "                            map_margin_m=None, loftr_coarse_threshold=LOFTR_COARSE_THRESHOLD, dino_weight=None, headings=[0.0], scale_factors=[1.0])\n",
    "t0 = time.time(); pipeline.setup(POOL_PHOTOS, 7); print(\"setup %.0f s\" % (time.time() - t0))\n",
    "test_set = pipeline.test_set\n",
    "T7 = ROOT / \"tests/Test_Iteration_7/results\"\n",
    "indices = sorted(int(i) for i in pd.read_csv(os.environ[\"PHOTOS_FILE\"]).photo)\n",
    "def grads(img):\n",
    "    b = cv2.GaussianBlur(np.asarray(img, np.float32), (0, 0), 1.0)\n",
    "    return cv2.Sobel(b, cv2.CV_32F, 1, 0, ksize=3), cv2.Sobel(b, cv2.CV_32F, 0, 1, ksize=3)\n",
    "def read_out(canvas, valid, window):\n",
    "    m = cv2.erode(valid.astype(np.uint8), np.ones((9, 9), np.uint8)) > 0\n",
    "    if m.sum() < 500:\n",
    "        return np.nan, np.nan\n",
    "    gxc, gyc = grads(canvas); gxm, gym = grads(window)\n",
    "    dot = float((gxc * gxm + gyc * gym)[m].sum())\n",
    "    norm = float(np.sqrt((gxc ** 2 + gyc ** 2)[m].sum() * (gxm ** 2 + gym ** 2)[m].sum()) + 1e-9)\n",
    "    ratio = float(np.sqrt(gxc ** 2 + gyc ** 2)[m].mean() / (np.sqrt(gxm ** 2 + gym ** 2)[m].mean() + 1e-9))\n",
    "    return dot / norm, ratio\n"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "rows = []\n",
    "for index in indices:\n",
    "    base_item = test_set.items[index]; prior = test_set.priors[index]; tx, ty = [float(v) for v in test_set.truths[index]]; sig = float(test_set.sigmas[index])\n",
    "    level = level_for_height(base_item[\"rel_height\"], pipeline.camera)\n",
    "    for kind in (\"clean\", \"invert\", \"blur\"):\n",
    "        item = dict(base_item) if kind == \"clean\" else perturbed_item(base_item, kind, str(T7 / \"perturbed_photos\" / \"official60_idea8\"), load_thermal_frame)\n",
    "        geom = query_geometry(0.0, 1.0)\n",
    "        found = pipeline.prepare_query(item, prior, level, geom)\n",
    "        canvas, valid = found[\"canvas\"], found[\"valid\"]\n",
    "        px, py = float(found[\"peaks\"][0, 1]), float(found[\"peaks\"][0, 2])\n",
    "        for where, (x, y) in ((\"truth\", (tx, ty)), (\"peak\", (px, py))):\n",
    "            cos, ratio = read_out(canvas, valid, map_piece(pipeline.level_images, level, x, y))\n",
    "            rows.append(dict(photo=index, kind=kind, where=where, cos=cos, ratio=ratio, height=base_item[\"rel_height\"], peak_err_sigma=float(np.hypot(px - tx, py - ty) / sig)))\n",
    "        torch.cuda.empty_cache()\n",
    "    if len(rows) % 60 == 0: print(len(rows), time.time() - t0, flush=True)\n",
    "D = pd.DataFrame(rows); D.to_csv(T7 / \"idea8_estimators.csv\", index=False)\n",
    "good = D[(D["where"] == \"peak\")].groupby(\"photo\").peak_err_sigma.first() <= 4\n",
    "print(\"photos with the top peak within 4 sigma:\", int(good.sum()), \"of\", len(good))\n",
    "for where in (\"truth\", \"peak\"):\n",
    "    g = D[D["where"] == where]\n",
    "    print(where); print(g.groupby(\"kind\").agg(n=(\"cos\", \"size\"), cos_median=(\"cos\", \"median\"), cos_neg=(\"cos\", lambda c: float((c < 0).mean())), ratio_median=(\"ratio\", \"median\"),\n",
    "          ratio_lt_075=(\"ratio\", lambda r: float((r < 0.75).mean()))).round(3).to_string())\n"
   ],
